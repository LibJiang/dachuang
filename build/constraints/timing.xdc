# timing.xdc —— HQC 加速器通用时序约束（草案）
# 目标：PYNQ-Z2 / Zynq-7020 (xc7z020clg400-1)
#
# 板级引脚见 pynq_z2_pins.xdc。
# 若使用 MMCM 生成 100 MHz 等频率，请注释掉本文件的 create_clock，
# 改用 create_generated_clock，并把实际时钟名写进报告。

# ---------------------------------------------------------------------------
# 1. 板载 PL 时钟：H16，125 MHz（8 ns）
# ---------------------------------------------------------------------------
create_clock -period 8.000 -waveform {0.000 4.000} -name clk [get_ports clk]

# 时钟不确定性（先给保守值，按实现结果收紧）
set_clock_uncertainty 0.100 [get_clocks clk]

# ---------------------------------------------------------------------------
# 2. 异步复位
# ---------------------------------------------------------------------------
# btn0 -> rst_n 的同步释放链在顶层实现；未完成 CDC 评审前不得简单 false_path。
# set_false_path -from [get_ports btn0]

# ---------------------------------------------------------------------------
# 3. 输入/输出延迟（按接口补）
# ---------------------------------------------------------------------------
# 若顶层有外部同步接口，按 PYNQ-Z2 时序填写：
# set_input_delay  -clock clk 2.000 [get_ports <input>]
# set_output_delay -clock clk 2.000 [get_ports <output>]

# ---------------------------------------------------------------------------
# 4. 禁止事项（评审时检查）
# ---------------------------------------------------------------------------
# - 禁止用 set_false_path 掩盖真实跨时钟域/组合路径；
# - 每条例外必须有注释：原因、评审人、对应接口；
# - 不允许对 all_clocks / all_registers 做通配豁免。

# ---------------------------------------------------------------------------
# 5. 报告归档（在 Vivado Tcl 控制台执行）
# ---------------------------------------------------------------------------
# report_timing_summary -file data/evidence/<日期>-<主题>/timing_summary.rpt
# report_utilization    -file data/evidence/<日期>-<主题>/utilization.rpt
